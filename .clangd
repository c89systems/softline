# Run make build-debug first to prepare the pinned dependencies, generated
# headers and compilation database used below. make test-clangd checks that
# this configuration/database is loaded and src/softline.c parses correctly.
CompileFlags:
  CompilationDatabase: build/debug
  Add:
    - -Iinclude
    - -Isrc
    - -D_POSIX_C_SOURCE=200809L
    - -std=c89
